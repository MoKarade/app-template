# .env.example — à copier en .env.local (JAMAIS committé) et dans les variables de
# l'hôte (Vercel, etc.). Aucune valeur réelle ici.

# ── Intégration hub ──────────────────────────────────────────────────────────
# Jeton partagé avec le hub. Il sert dans LES DEUX SENS :
#   ENTRANT  — le hub l'envoie dans le header x-hub-token pour lire GET /hub/summary.
#              absent → 503 (intégration désactivée, pas une panne) ; invalide → 401.
#   SORTANT  — l'app le présente au hub sur POST /api/acces (lib/accesHub.ts) pour
#              demander « cette personne a-t-elle le droit d'entrer ici ? ». C'est ce
#              jeton qui IDENTIFIE l'app côté hub, donc aucun appId n'est envoyé.
#              Absent → aucun invité n'entre (échec fermé) ; le propriétaire, lui, passe.
# La MÊME valeur doit être posée ici et dans HUB_TOKEN_<ID> côté Hubperso.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HUB_TOKEN=

# ── Authentification (Auth.js v5) — app PRIVÉE, autorisation dans le hub ─────
# Sans AUTH_SECRET **et** AUTHORIZED_EMAIL, le proxy refuse TOUT ce qui est
# protégé (503). C'est voulu : Auth.js seul se contente de logguer MissingSecret et
# LAISSE PASSER — une app privée ne doit jamais échouer ouvert.
# Générer AUTH_SECRET : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=
# Le PROPRIÉTAIRE. Comparé en minuscules, espaces retirés.
#
# ⚠️ CE N'EST PAS « la seule adresse admise » : c'est « celle qui a accès à tout,
# toujours, SANS passer par le hub ». Les autres personnes vivent dans la table `acces`
# du hub et se gèrent depuis hubperso.com/administration — jamais en éditant cette ligne.
#
# Cette porte de service existe pour la situation qui enfermerait sinon dehors : hub
# injoignable, ou ligne supprimée par erreur. Sans elle, une panne du hub fermerait
# toutes les apps d'un coup, y compris celle d'où on irait la réparer.
AUTHORIZED_EMAIL=

# Pas de GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET : cette app n'a aucun fournisseur
# (`providers: []` dans auth.ts). Elle LIT la session que le hub pose sur .hubperso.com ;
# /login renvoie au hub. Rien à déclarer côté Google Cloud.

# JWKS (JSON, une seule ligne) des clés PUBLIQUES publiées par le hub, pour vérifier son
# cookie de session signé (@mokarade/hub-contract/session, lib/sessionAsymetrique.ts).
# Jamais de clé privée ici. Absente ou illisible → aucune session signée n'est acceptée
# (repli sur la session Auth.js), sans erreur. À poser quand le hub les publie.
HUB_SESSION_PUBLIC_KEYS=

# CONNEXION UNIQUE entre les apps du hub. Déclare le cookie de session sur le domaine
# PARENT : se connecter à une app vaut alors pour toutes celles qui partagent ce domaine
# ET le même AUTH_SECRET. Corollaire assumé : se déconnecter aussi.
#
# ⚠️ À poser UNIQUEMENT en production. Un cookie Domain=.hubperso.com est rejeté sur
# localhost et sur <projet>.vercel.app, et il l'est SILENCIEUSEMENT : le cookie n'est pas
# posé, on boucle sur /login, et rien n'apparaît nulle part comme une erreur.
# AUTH_COOKIE_DOMAIN=.hubperso.com

# ── Optionnel ────────────────────────────────────────────────────────────────
# URL du hub. Sert à la fois au lien « ← Hub » de l'en-tête ET de destination à
# POST /api/acces (lib/accesHub.ts) et à POST /api/lia/ask (lib/lia/demander.ts, LIA). Défaut : https://hubperso.com.
#
# ⚠️ La pointer ailleurs « pour tester » coupe l'accès de TOUTES les personnes autres que
# le propriétaire, silencieusement (échec fermé → false).
# NEXT_PUBLIC_HUB_URL=https://hubperso.com

# Suivi des erreurs (Sentry). Un DSN n'est pas un secret fort, mais ne le publie pas non plus.
# Absent ou vide : Sentry reste éteint, rien ne part et l'app se construit sans erreur.
# Une seule variable : next.config.mjs la donne aussi au navigateur. Aucune donnée personnelle
# n'est envoyée (lib/sentryConfig.ts, verrou tests/sentryConfig.test.ts).
# SENTRY_DSN=
